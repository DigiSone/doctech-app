---
import Layout from '../layouts/Layout.astro';
import masterData from '../data/master_core.json';

const { categories, departments } = masterData;
---
<Layout title="विकास जन सेवा केंद्र | एकीकृत नागरिक सेवा एवं ई-डिस्ट्रिक्ट पोर्टल (DocTech)">

  <main class="w-full space-y-12 pb-16">

    <!-- HERO SECTION: GRAND WELCOME & VOICE ASSISTANT -->
    <section class="relative bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-900 text-white pt-10 pb-16 px-4 overflow-hidden">
      <!-- Background Ambient Glow -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-64 bg-indigo-500/20 blur-3xl rounded-full pointer-events-none"></div>

      <div class="max-w-5xl mx-auto text-center space-y-5 relative z-10">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-bold text-emerald-300 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>उ.प्र. शासन शासनादेश अनुसार 100% पारदर्शी अधिकृत दरें लागू</span>
        </div>

        <!-- Headline -->
        <h1 class="text-2xl sm:text-5xl font-black tracking-tight leading-tight sm:leading-snug">
          सरकारी प्रमाण पत्र एवं नागरिक सेवाएँ, <br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-indigo-300">
            बिना बिचौलिए, सीधे और पारदर्शी रूप से
          </span>
        </h1>

        <p class="text-xs sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-medium px-2">
          तहसील और दफ्तरों के चक्कर काटने की जरूरत नहीं। अपने मोबाइल से अपनी श्रेणी या विभाग चुनकर अधिकृत सरकारी दस्तावेजों के लिए आवेदन करें।
        </p>

        <!-- VOICE GUIDANCE AUDIO STRIP (FOR RURAL & ILLITERATE CITIZENS) -->
        <div class="pt-2">
          <div class="inline-flex flex-col sm:flex-row items-center gap-3 p-2 sm:p-2.5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 shadow-xl max-w-lg mx-auto">
            <button onclick="window.playVoiceGuide()" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-black text-xs sm:text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95 shrink-0">
              <span class="text-lg animate-bounce">🔊</span>
              <span>यहाँ दबाकर आवाज़ में सुनें (बोलकर समझें)</span>
            </button>
            <span class="text-[11px] text-slate-300 font-medium px-2 text-center sm:text-left">
              कम पढ़े-लिखे नागरिक सुनकर समझ सकते हैं कि उन्हें कहाँ क्लिक करना है।
            </span>
          </div>
        </div>

        <!-- QUICK ACCESS SEARCH & TRACKING HUB -->
        <div class="pt-4 max-w-2xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="/track" class="p-4 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 text-left transition flex items-center gap-3.5 group">
            <div class="w-12 h-12 rounded-xl bg-indigo-500/30 border border-indigo-400/30 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition">
              🔍
            </div>
            <div>
              <span class="text-[11px] text-indigo-300 font-bold block uppercase tracking-wider">आवेदन ट्रैकिंग केंद्र</span>
              <strong class="text-sm font-black text-white block">आवेदन की स्थिति जांचें &rarr;</strong>
              <span class="text-[10px] text-slate-400">रसीद व मूल प्रमाण पत्र डाउनलोड करें</span>
            </div>
          </a>

          <a href="/rate-card" class="p-4 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 text-left transition flex items-center gap-3.5 group">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/30 border border-emerald-400/30 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition">
              📋
            </div>
            <div>
              <span class="text-[11px] text-emerald-300 font-bold block uppercase tracking-wider">पारदर्शी शुल्क सूची</span>
              <strong class="text-sm font-black text-white block">अधिकृत सरकारी दरें देखें &rarr;</strong>
              <span class="text-[10px] text-slate-400">सरकारी चालान + ₹30 VLE सेवा शुल्क</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 1: CITIZEN PERSONA GATEWAYS (Who Are You?) -->
    <section class="max-w-7xl mx-auto px-4 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 pb-4">
        <div>
          <div class="inline-flex items-center gap-1.5 text-indigo-600 font-black text-xs uppercase tracking-wider">
            <span>द्वार 1</span> &bull; <span>नागरिक श्रेणियाँ (Citizen Portals)</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight mt-0.5">
            आप कौन हैं? अपनी श्रेणी चुनें:
          </h2>
        </div>
        <p class="text-xs text-slate-500 font-medium max-w-sm">
          प्रत्येक नागरिक वर्ग के लिए समर्पित पृष्ठ, जहाँ आपकी आवश्यकता से जुड़ी समस्त सेवाएँ एक स्थान पर मिलेंगी।
        </p>
      </div>

      <!-- 6 Big Visual Category Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {categories.map((cat) => (
          <a href={`/category/${cat.id}`} class="group bg-white rounded-3xl p-6 border border-slate-200/90 shadow-xs hover:shadow-xl hover:border-indigo-400 transition-all duration-300 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-3xl p-3 rounded-2xl bg-slate-50 border border-slate-100 group-hover:scale-110 transition shrink-0">
                  {cat.icon}
                </span>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold border bg-slate-50 text-slate-700 border-slate-200">
                  {cat.badge}
                </span>
              </div>

              <div>
                <h3 class="text-lg font-black text-slate-900 group-hover:text-indigo-600 transition leading-snug">
                  {cat.title}
                </h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed font-medium">
                  {cat.subtitle}
                </p>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-indigo-600 group-hover:translate-x-1 transition">
              <span>इस वर्ग की सेवाएँ देखें</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- SECTION 2: OFFICIAL GOVERNMENT DEPARTMENTS (14 MINISTRIES) -->
    <section class="max-w-7xl mx-auto px-4 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 pb-4">
        <div>
          <div class="inline-flex items-center gap-1.5 text-indigo-600 font-black text-xs uppercase tracking-wider">
            <span>द्वार 2</span> &bull; <span>शासकीय विभाग (Government Ministries)</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight mt-0.5">
            सीधे विभाग अनुसार दस्तावेज़ खोजें:
          </h2>
        </div>
        <p class="text-xs text-slate-500 font-medium max-w-sm">
          उत्तर प्रदेश शासन के 14 आधिकारिक विभागों से संबद्ध प्रमाणित डिजिटल सेवाएँ।
        </p>
      </div>

      <!-- Department Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {departments.map((dept) => (
          <a href={`/department/${dept.id}`} class="group bg-white p-4 rounded-2xl border border-slate-200 shadow-xs hover:border-indigo-400 hover:shadow-md transition flex flex-col justify-between space-y-2.5">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="text-xl shrink-0">{dept.icon}</span>
                <h3 class="font-extrabold text-xs text-slate-900 leading-snug group-hover:text-indigo-600 transition">
                  {dept.name}
                </h3>
              </div>
              <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
                {dept.desc}
              </p>
            </div>

            <div class="flex items-center justify-between text-[10px] text-slate-400 font-semibold pt-1 border-t border-slate-100">
              <span class="truncate font-mono">{dept.official_portal}</span>
              <span class="text-indigo-600 font-bold group-hover:translate-x-1 transition">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- SECTION 3: TRANSPARENT FEE GUARANTEE & STATUTORY MODEL -->
    <section class="max-w-5xl mx-auto px-4">
      <div class="bg-indigo-50/70 border border-indigo-100 rounded-3xl p-6 sm:p-8 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-2xl">⚖️</span>
          <h2 class="text-base sm:text-lg font-black text-slate-900">
            उत्तर प्रदेश शासन शासनादेश अनुसार 100% पारदर्शी शुल्क नीति
          </h2>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
          विकास जन सेवा केंद्र पर प्रत्येक सेवा का शुल्क दो स्पष्ट भागों में विभाजित होता है:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-1">
          <div class="bg-white p-4 rounded-2xl border border-slate-200">
            <span class="text-slate-400 block text-[10px] font-bold uppercase">भाग 1</span>
            <strong class="text-slate-900 text-sm block mt-0.5">शासकीय चालान (Govt Fee)</strong>
            <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
              सरकारी कोषागार अथवा e-District वॉलेट में जमा होने वाला अनिवार्य सरकारी शुल्क (जैसे आय/जाति/निवास: ₹15, पुलिस: ₹50, पैन: ₹107)।
            </p>
          </div>

          <div class="bg-white p-4 rounded-2xl border border-slate-200">
            <span class="text-slate-400 block text-[10px] font-bold uppercase">भाग 2</span>
            <strong class="text-slate-900 text-sm block mt-0.5">VLE सेवा शुल्क (Service Charge)</strong>
            <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
              डिजिटल प्रविष्टि, ड्राफ्टिंग, फोटो/आधार स्कैनिंग एवं सुरक्षित प्रक्रिया हेतु अधिकृत <strong>फ्लैट ₹30.00</strong> सेवा शुल्क।
            </p>
          </div>

          <div class="bg-indigo-900 text-white p-4 rounded-2xl shadow-sm">
            <span class="text-indigo-300 block text-[10px] font-bold uppercase">कुल देय राशि</span>
            <strong class="text-emerald-400 text-sm block mt-0.5">100% रसीद व QR युक्त पावती</strong>
            <p class="text-[11px] text-indigo-200 mt-1 leading-relaxed">
              भुगतान के तुरंत बाद आधिकारिक मुहर युक्त डिजिटल पावती रसीद, जिसे कभी भी ऑनलाइन सत्यापित किया जा सकता है।
            </p>
          </div>
        </div>

        <div class="pt-2 text-center sm:text-left">
          <a href="/rate-card" class="inline-flex items-center gap-1.5 text-xs font-black text-indigo-700 hover:text-indigo-900 underline">
            <span>सभी 35 सेवाओं की पूर्ण अधिकृत शासकीय दर सूची देखें</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- CLIENT-SIDE VOICE ASSISTANT SCRIPT -->
  <script is:inline>
    window.playVoiceGuide = function() {
      if (!('speechSynthesis' in window)) {
        alert("आपके ब्राउज़र में वॉयस सपोर्ट उपलब्ध नहीं है।");
        return;
      }
      window.speechSynthesis.cancel();
      const text = "विकास जन सेवा केंद्र में आपका स्वागत है। अगर आप छात्र हैं और आय, जाति, निवास या छात्रवृत्ति चाहते हैं, तो छात्र वर्ग पर दबाएँ। अगर आप महिला पेंशन या राशन कार्ड चाहते हैं, तो महिला कल्याण वर्ग पर दबाएँ। अगर आप किसान हैं और खतौनी या वरासत चाहते हैं, तो किसान वर्ग पर दबाएँ। किसी भी सहायता के लिए नीचे सहायता केंद्र पर संपर्क करें।";
      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'hi-IN';
      u.rate = 0.92;
      window.speechSynthesis.speak(u);
    };
  </script>
</Layout>
