---
import Layout from '../layouts/Layout.astro';
import masterData from '../data/master_core.json';

const { departments, services } = masterData;
---
<Layout title="विकास जन सेवा केंद्र | अधिकृत ई-डिस्ट्रिक्ट नागरिक सेवा पोर्टल">

  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs no-print">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-2">
      <a href="/" class="flex items-center gap-2.5 min-w-0">
        <img src="/favicon.svg" alt="DocTech Logo" class="w-10 h-10 rounded-xl shadow-xs shrink-0" />
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="font-black text-slate-900 text-lg leading-none tracking-tight">DocTech</span>
            <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 text-[9px] font-black border border-emerald-200 leading-none">अधिकृत CSC</span>
          </div>
          <span class="text-[10px] text-slate-500 font-semibold block truncate mt-0.5">विकास जन सेवा केंद्र • सोनभद्र</span>
        </div>
      </a>

      <div class="flex items-center gap-2 shrink-0">
        <button onclick="window.openRateCardModal()" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-700 text-xs font-bold border border-slate-200 transition">
          📋 अधिकृत दर सूची
        </button>
        <button onclick="window.playAudioIntro()" title="AI आवाज़ सुनें" class="w-9 h-9 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 flex items-center justify-center border border-indigo-100 text-sm active:scale-95 transition">
          🔊
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-6 w-full space-y-8 no-print">
    
    <section class="text-center max-w-3xl mx-auto space-y-3 pt-2">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white border border-indigo-100 shadow-xs text-[11px] font-bold text-slate-700">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>उ.प्र. शासन शासनादेश दरें लागू (100% पारदर्शी शासकीय शुल्क + ₹30 VLE शुल्क)</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-snug">
        सरकारी प्रमाण पत्र एवं नागरिक सेवाएँ, <br>
        <span class="text-indigo-600">पारदर्शी तरीके से घर बैठे बनवाएँ</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 font-medium leading-relaxed px-2">
        तहसील जाने की आवश्यकता नहीं। जन सेवा केंद्र द्वारा आवेदन करें अथवा सीधे आधिकारिक सरकारी पोर्टल से सत्यापन करें।
      </p>
    </section>

    <!-- Unified Search & Live Tracking Hub -->
    <section class="max-w-3xl mx-auto space-y-3">
      <div class="bg-white p-2 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-2 focus-within:border-indigo-600 focus-within:ring-2 focus-within:ring-indigo-600/10 transition">
        <span class="pl-2 text-slate-400 text-sm">🔍</span>
        <input type="text" id="liveSearchInput" oninput="window.handleFilterAndSearch()" 
               placeholder="सेवा खोजें (आय, जाति, निवास, खतौनी, राशन, पेंशन, पैन, पुलिस...)" 
               class="flex-1 py-2 px-1 text-xs sm:text-sm font-semibold text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none">
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-extrabold text-slate-800 uppercase tracking-wide">आवेदन स्थिति जांचें एवं मूल प्रमाण पत्र डाउनलोड करें</span>
          <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">24x7 Live</span>
        </div>

        <div class="flex gap-2">
          <input type="text" id="trackInput" placeholder="आवेदन संख्या दर्ज करें (उदा. DT-2609-XXXX)" 
                 class="flex-1 px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-indigo-600 text-xs font-mono uppercase font-semibold">
          <button onclick="window.handleTrack()" id="trackBtn"
                  class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition active:scale-95 shrink-0">
            स्थिति देखें
          </button>
        </div>

        <div class="flex items-center justify-between pt-1">
          <button type="button" onclick="window.openMobileSearchModal()" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
            <span>📱</span> <span>आवेदन संख्या भूल गए? मोबाइल नंबर से खोजें</span>
          </button>
        </div>

        <div id="trackResultBox" class="hidden p-4 rounded-xl bg-indigo-50/60 border border-indigo-100 space-y-3">
          <div class="flex items-center justify-between border-b border-indigo-100 pb-2">
            <div>
              <span class="text-[10px] text-slate-500 font-bold block">आवेदन संख्या</span>
              <span id="resAppNo" class="text-xs font-bold text-indigo-700 font-mono"></span>
            </div>
            <span id="resStatusBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold shadow-xs"></span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] bg-white p-3 rounded-lg border border-slate-200/80">
            <div><span class="text-slate-400 block">आवेदक:</span><strong id="resName" class="text-slate-900 block truncate"></strong></div>
            <div><span class="text-slate-400 block">सेवा:</span><strong id="resService" class="text-slate-900 block truncate"></strong></div>
            <div><span class="text-slate-400 block">सरकारी संदर्भ सं.:</span><strong id="resGovtRef" class="text-slate-900 font-mono block truncate">-</strong></div>
            <div><span class="text-slate-400 block">आवेदन तिथि:</span><strong id="resDate" class="text-slate-900 block truncate"></strong></div>
          </div>

          <div class="bg-white p-3 rounded-lg border border-slate-200/80 space-y-2">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">विभागीय कार्य प्रगति:</span>
            <div class="grid grid-cols-5 text-center text-[9px] font-bold gap-1" id="timelineStages">
              <div class="p-1 rounded bg-indigo-50 text-indigo-700" id="step_submit">1. दर्ज हुआ</div>
              <div class="p-1 rounded bg-slate-100 text-slate-500" id="step_punch">2. e-District पंच</div>
              <div class="p-1 rounded bg-slate-100 text-slate-500" id="step_inquiry">3. विभागीय जांच</div>
              <div class="p-1 rounded bg-slate-100 text-slate-500" id="step_approved">4. स्वीकृत</div>
              <div class="p-1 rounded bg-slate-100 text-slate-500" id="step_delivered">5. जारी</div>
            </div>
          </div>

          <div id="certContainer" class="hidden pt-1">
            <a id="certLink" href="#" target="_blank" class="w-full flex items-center justify-center gap-1.5 py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-xs transition">
              मूल डिजिटल हस्ताक्षरित प्रमाण पत्र डाउनलोड करें (Verified PDF)
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Personas Filter -->
    <section class="space-y-2.5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-extrabold text-slate-900 uppercase tracking-wider">1. अपनी नागरिक श्रेणी चुनें:</h2>
        <span class="text-xs font-bold text-slate-500">कुल <span id="visibleCount" class="text-indigo-600 font-mono font-black">{services.length}</span> सेवाएँ</span>
      </div>

      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1" id="personaPills">
        <button onclick="window.setPersonaFilter('all')" class="persona-btn active px-3.5 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-xs shrink-0" data-target="all">
          सभी नागरिक ({services.length})
        </button>
        <button onclick="window.setPersonaFilter('students')" class="persona-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0" data-target="students">
          🎓 छात्र व युवा
        </button>
        <button onclick="window.setPersonaFilter('women')" class="persona-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0" data-target="women">
          👩 महिला कल्याण
        </button>
        <button onclick="window.setPersonaFilter('farmers')" class="persona-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0" data-target="farmers">
          🌾 किसान व भूमि
        </button>
        <button onclick="window.setPersonaFilter('seniors')" class="persona-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0" data-target="seniors">
          👴 वरिष्ठ व दिव्यांग
        </button>
        <button onclick="window.setPersonaFilter('business')" class="persona-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0" data-target="business">
          💼 व्यापारी व MSME
        </button>
        <button onclick="window.setPersonaFilter('citizens')" class="persona-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0" data-target="citizens">
          🏠 सामान्य नागरिक
        </button>
      </div>
    </section>

    <!-- Departments Filter -->
    <section class="space-y-2.5">
      <h2 class="text-sm font-extrabold text-slate-900 uppercase tracking-wider">2. सरकारी विभाग चुनें:</h2>
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1" id="deptPills">
        <button onclick="window.setDeptFilter('all')" class="dept-btn active px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white shrink-0" data-target="all">
          समस्त विभाग
        </button>
        {departments.map((d) => (
          <button onclick={`window.setDeptFilter('${d.id}')`} class="dept-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0 flex items-center gap-1.5" data-target={d.id}>
            <span>{d.icon}</span>
            <span>{d.name.split('(')[0].trim()}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- 35 Services Grid with Dual Action Buttons -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="servicesGrid">
      {services.map((svc) => (
        <div class="service-card bg-white p-5 rounded-2xl border border-slate-200/90 shadow-xs flex flex-col justify-between"
             data-id={svc.id}
             data-dept={svc.dept_id}
             data-name={svc.name.toLowerCase()}
             data-desc={svc.desc.toLowerCase()}
             data-personas={JSON.stringify(svc.personas)}
             data-govt-fee={svc.govt_fee.toFixed(2)}
             data-vle-fee={svc.vle_fee.toFixed(2)}
             data-total-fee={(svc.govt_fee + svc.vle_fee).toFixed(2)}
             data-fields={JSON.stringify(svc.fields)}>
          
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-black text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100 truncate max-w-[180px]">
                {departments.find(d => d.id === svc.dept_id)?.name.split('(')[0].trim()}
              </span>
              <button onclick={`window.educateService('${svc.name}', '${svc.govt_fee.toFixed(2)}', '${svc.vle_fee.toFixed(2)}')`} 
                      class="text-[11px] font-bold text-slate-500 hover:text-indigo-600 flex items-center gap-1">
                <span>🔊 समझें</span>
              </button>
            </div>

            <div>
              <h3 class="font-extrabold text-sm text-slate-900 leading-snug">{svc.name}</h3>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">{svc.desc}</p>
            </div>

            <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200/80 text-[11px] space-y-1">
              <div class="flex justify-between text-slate-600">
                <span>सरकारी चालान (Govt Fee):</span>
                <span class="font-mono font-bold text-slate-800">₹{svc.govt_fee.toFixed(2)}</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>अधिकृत VLE सेवा शुल्क:</span>
                <span class="font-mono font-bold text-slate-800">₹{svc.vle_fee.toFixed(2)}</span>
              </div>
              <div class="flex justify-between text-slate-900 font-extrabold border-t border-slate-200 pt-1">
                <span>कुल देय वैधानिक दर:</span>
                <span class="font-mono text-indigo-700 text-xs">₹{(svc.govt_fee + svc.vle_fee).toFixed(2)}</span>
              </div>
            </div>
          </div>

          <!-- Dual Buttons: Facilitated Apply + Direct Govt Portal -->
          <div class="mt-4 space-y-2">
            <button onclick={`window.openPolymorphicModal('${svc.id}')`} 
                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition active:scale-95 flex items-center justify-center gap-1">
              <span>📝 जन सेवा केंद्र से आवेदन करें &rarr;</span>
            </button>
            <a href={svc.govt_portal_url} target="_blank" rel="noopener noreferrer"
               class="w-full py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[11px] rounded-xl border border-slate-200 transition flex items-center justify-center gap-1">
              <span>🌐 आधिकारिक सरकारी पोर्टल ({svc.govt_portal_name})</span>
            </a>
          </div>
        </div>
      ))}
    </section>
  </main>

  <!-- Rate Card Modal -->
  <div id="rateCardModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-3 overflow-y-auto no-print">
    <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl border border-slate-200 my-4 overflow-hidden flex flex-col">
      <div class="px-5 py-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
        <div>
          <h3 class="text-sm font-extrabold text-slate-900">अधिकृत शासकीय सेवा दर सूची (Official Rate Card)</h3>
          <p class="text-[11px] text-slate-500 font-medium">उत्तर प्रदेश शासन शासनादेश एवं CSC e-Governance द्वारा निर्धारित</p>
        </div>
        <button onclick="window.closeRateCardModal()" class="w-7 h-7 rounded-full bg-slate-200 text-slate-600 hover:bg-slate-300 flex items-center justify-center text-sm font-bold">&times;</button>
      </div>

      <div class="p-5 overflow-y-auto max-h-[70vh] text-xs space-y-3">
        <table class="w-full border border-slate-200 rounded-xl overflow-hidden text-[11px]">
          <thead class="bg-slate-100 text-slate-700 text-left">
            <tr>
              <th class="p-2 border-b border-slate-200">सेवा का नाम</th>
              <th class="p-2 border-b border-slate-200">सरकारी चालान</th>
              <th class="p-2 border-b border-slate-200">VLE शुल्क</th>
              <th class="p-2 border-b border-slate-200">कुल दर</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {services.map(s => (
              <tr class="hover:bg-slate-50">
                <td class="p-2 font-semibold text-slate-900">{s.name}</td>
                <td class="p-2 font-mono text-slate-600">₹{s.govt_fee.toFixed(2)}</td>
                <td class="p-2 font-mono text-slate-600">₹{s.vle_fee.toFixed(2)}</td>
                <td class="p-2 font-mono font-bold text-indigo-700">₹{(s.govt_fee + s.vle_fee).toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Mobile Search Modal -->
  <div id="mobileSearchModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-3 no-print">
    <div class="bg-white max-w-md w-full rounded-2xl shadow-2xl border border-slate-200 p-5 space-y-4 text-xs">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2">
        <div class="flex items-center gap-2">
          <span class="text-base">📱</span>
          <h3 class="font-extrabold text-slate-900 text-sm">मोबाइल नंबर से आवेदन खोजें</h3>
        </div>
        <button onclick="window.closeMobileSearchModal()" class="text-slate-400 hover:text-slate-600 text-lg font-bold">&times;</button>
      </div>
      <p class="text-[11px] text-slate-500 font-medium">आवेदन करते समय दर्ज किया गया 10 अंकों का मोबाइल नंबर दर्ज करें:</p>
      <div class="flex gap-2">
        <input type="tel" id="searchMobileInput" pattern="[0-9]{10}" placeholder="10 अंकों का मोबाइल नंबर" class="flex-1 px-3 py-2.5 border border-slate-300 rounded-xl font-mono text-xs font-bold">
        <button onclick="window.executeSearchByMobile()" id="btnSearchByMobile" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-xs shadow-xs">खोजें</button>
      </div>
      <div id="mobileSearchResults" class="max-h-60 overflow-y-auto divide-y divide-slate-100 hidden space-y-2"></div>
    </div>
  </div>

  <!-- Universal 3-Step Polymorphic Application Modal -->
  <div id="applyModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-3 overflow-y-auto no-print">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 my-4 overflow-hidden flex flex-col">
      <div class="px-5 py-4 border-b border-slate-100 bg-slate-50">
        <div class="flex items-center justify-between mb-2.5">
          <div class="min-w-0 pr-2">
            <h3 id="modalTitle" class="text-sm font-extrabold text-slate-900 truncate">ई-डिस्ट्रिक्ट आधिकारिक आवेदन</h3>
            <p id="modalDeptName" class="text-[11px] text-slate-500 font-medium truncate"></p>
          </div>
          <button onclick="window.closeModal()" class="w-7 h-7 rounded-full bg-slate-200 text-slate-600 hover:bg-slate-300 flex items-center justify-center text-sm font-bold shrink-0">&times;</button>
        </div>

        <div class="grid grid-cols-3 gap-1.5 text-center text-[10px] font-bold">
          <div id="stepTag1" class="py-1.5 px-1 rounded-lg bg-indigo-600 text-white">1. जानकारी दर्ज</div>
          <div id="stepTag2" class="py-1.5 px-1 rounded-lg bg-slate-200 text-slate-600">2. समीक्षा व शुल्क</div>
          <div id="stepTag3" class="py-1.5 px-1 rounded-lg bg-slate-200 text-slate-600">3. भुगतान व UTR</div>
        </div>
      </div>

      <!-- Step 1 Form -->
      <form id="applyForm" onsubmit="window.handleFormReview(event)" class="p-5 space-y-3.5 text-xs">
        <input type="hidden" id="curServiceId">

        <div>
          <label class="block font-bold text-slate-700 mb-1">आवेदक का पूरा नाम (आधार अनुसार) *</label>
          <input type="text" id="applicantName" required placeholder="पूरा नाम लिखें" 
                 class="w-full px-3 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-600 text-xs font-semibold">
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">मोबाइल नंबर (WhatsApp पावती हेतु) *</label>
          <input type="tel" id="mobileNo" required pattern="[0-9]{10}" placeholder="10 अंकों का मोबाइल नंबर" 
                 class="w-full px-3 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-600 font-mono text-xs">
        </div>

        <div id="dynamicFieldsContainer" class="space-y-3"></div>

        <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
          <span class="font-bold text-slate-800 block text-xs">अनिवार्य दस्तावेज़ संलग्नक (अधिकतम 10MB):</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div class="bg-white p-2.5 rounded-lg border border-slate-200">
