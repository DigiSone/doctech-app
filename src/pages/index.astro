        electricity_load_kw: { label: "विद्युत भार (kW) *", type: "number", placeholder: "उदा. 1 या 2" },
        pan_no: { label: "पैन कार्ड संख्या *", type: "text", placeholder: "ABCDE1234F" },
        aadhaar_no: { label: "आधार संख्या (12 अंक) *", type: "text", placeholder: "12 अंकों का आधार" },
        caste_category: { label: "जाति वर्ग (Category) *", type: "select", options: ["OBC (अन्य पिछड़ा वर्ग)", "SC (अनुसूचित जाति)", "ST (अनुसूचित जनजाति)", "General (सामान्य)"] },
        sub_caste: { label: "उप-जाति (Sub-caste) *", type: "text", placeholder: "उपजाति लिखें" },
        blood_group: { label: "रक्त समूह (Blood Group) *", type: "select", options: ["O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-", "अज्ञात"] },
        vehicle_category: { label: "वाहन श्रेणी *", type: "select", options: ["MCWG (दोपहिया)", "LMV (चारपहिया)", "BOTH (दोपहिया + चारपहिया)"] },
        tehsil: { label: "तहसील *", type: "select", options: ["Robertsganj (रॉबर्ट्सगंज)", "Ghorawal (घोरावल)", "Duddhi (दुद्धी)", "Obra (ओबरा)"] },
        address: { label: "ग्राम / वार्ड एवं पूरा स्थायी पता *", type: "textarea", placeholder: "मकान नं., ग्राम/वार्ड, पोस्ट, पिन..." }
      };
      const cfg = fieldMap[f] || { label: f + " *", type: "text", placeholder: "जानकारी लिखें" };

      if (cfg.type === 'select') {
        let opts = cfg.options.map(function(o) { return '<option value="' + o + '">' + o + '</option>'; }).join('');
        return '<div><label class="block font-bold text-slate-700 mb-1">' + cfg.label + '</label><select id="field_' + f + '" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold">' + opts + '</select></div>';
      } else if (cfg.type === 'textarea') {
        return '<div><label class="block font-bold text-slate-700 mb-1">' + cfg.label + '</label><textarea id="field_' + f + '" required rows="2" placeholder="' + cfg.placeholder + '" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs"></textarea></div>';
      } else {
        return '<div><label class="block font-bold text-slate-700 mb-1">' + cfg.label + '</label><input type="' + cfg.type + '" id="field_' + f + '" required placeholder="' + cfg.placeholder + '" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs"></div>';
      }
    }

    window.openPolymorphicModal = function(serviceId) {
      const card = document.querySelector('.service-card[data-id="' + serviceId + '"]');
      if (!card) return;

      currentServiceObj = {
        id: serviceId,
        name: card.querySelector('h3').innerText,
        dept: card.dataset.dept,
        govt_fee: card.dataset.govtFee,
        vle_fee: card.dataset.vleFee,
        total_fee: card.dataset.totalFee,
        fields: JSON.parse(card.dataset.fields || '[]')
      };

      document.getElementById('curServiceId').value = serviceId;
      document.getElementById('modalTitle').innerText = currentServiceObj.name;
      document.getElementById('modalDeptName').innerText = "शासकीय चालान: ₹" + currentServiceObj.govt_fee + " + अधिकृत VLE शुल्क: ₹" + currentServiceObj.vle_fee;

      const container = document.getElementById('dynamicFieldsContainer');
      container.innerHTML = '';
      currentServiceObj.fields.forEach(function(f) {
        container.innerHTML += generateFieldHtml(f);
      });

      window.updateStepTracker(1);
      document.getElementById('applyForm').classList.remove('hidden');
      document.getElementById('reviewStep').classList.add('hidden');
      document.getElementById('paymentStep').classList.add('hidden');
      const m = document.getElementById('applyModal');
      m.classList.remove('hidden');
      m.classList.add('flex');
    };

    window.closeModal = function() {
      const m = document.getElementById('applyModal');
      m.classList.add('hidden');
      m.classList.remove('flex');
      document.getElementById('applyForm').reset();
    };

    window.openRateCardModal = function() {
      const m = document.getElementById('rateCardModal');
      m.classList.remove('hidden');
      m.classList.add('flex');
    };
    window.closeRateCardModal = function() {
      const m = document.getElementById('rateCardModal');
      m.classList.add('hidden');
      m.classList.remove('flex');
    };

    window.openMobileSearchModal = function() {
      const m = document.getElementById('mobileSearchModal');
      m.classList.remove('hidden');
      m.classList.add('flex');
    };
    window.closeMobileSearchModal = function() {
      const m = document.getElementById('mobileSearchModal');
      m.classList.add('hidden');
      m.classList.remove('flex');
    };

    window.closeReceiptModal = function() {
      const m = document.getElementById('receiptModal');
      m.classList.add('hidden');
      m.classList.remove('flex');
    };

    window.toggleHelpdeskMenu = function() {
      document.getElementById('helpdeskMenu').classList.toggle('hidden');
    };

    window.updateStepTracker = function(step) {
      const active = "py-1.5 px-1 rounded-lg bg-indigo-600 text-white";
      const inactive = "py-1.5 px-1 rounded-lg bg-slate-200 text-slate-600";
      document.getElementById('stepTag1').className = step === 1 ? active : inactive;
      document.getElementById('stepTag2').className = step === 2 ? active : inactive;
      document.getElementById('stepTag3').className = step === 3 ? active : inactive;
    };

    window.handleFilterAndSearch = function() {
      const q = document.getElementById('liveSearchInput').value.trim().toLowerCase();
      const cards = document.querySelectorAll('.service-card');
      let count = 0;

      cards.forEach(function(card) {
        const name = card.dataset.name || '';
        const desc = card.dataset.desc || '';
        const dept = card.dataset.dept || '';
        const personas = JSON.parse(card.dataset.personas || '[]');

        const matchesQuery = name.includes(q) || desc.includes(q);
        const matchesPersona = (activePersona === 'all') || personas.includes(activePersona);
        const matchesDept = (activeDept === 'all') || (dept === activeDept);

        if (matchesQuery && matchesPersona && matchesDept) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });
      document.getElementById('visibleCount').innerText = count;
    };

    window.setPersonaFilter = function(pKey) {
      activePersona = pKey;
      document.querySelectorAll('.persona-btn').forEach(function(btn) {
        btn.className = btn.dataset.target === pKey 
          ? "persona-btn active px-3.5 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-xs shrink-0"
          : "persona-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0";
      });
      window.handleFilterAndSearch();
    };

    window.setDeptFilter = function(dKey) {
      activeDept = dKey;
      document.querySelectorAll('.dept-btn').forEach(function(btn) {
        btn.className = btn.dataset.target === dKey
          ? "dept-btn active px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white shrink-0"
          : "dept-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shrink-0";
      });
      window.handleFilterAndSearch();
    };

    window.handleFormReview = async function(e) {
      e.preventDefault();
      const photoFile = document.getElementById('applicantPhoto').files[0];
      const idFile = document.getElementById('idProof').files[0];

      if (photoFile && photoFile.size > 10 * 1024 * 1024) {
        alert("फोटो साइज़ 10MB से कम होना चाहिए!");
        return;
      }
      if (idFile && idFile.size > 10 * 1024 * 1024) {
        alert("पहचान प्रमाण साइज़ 10MB से कम होना चाहिए!");
        return;
      }

      const extracted = {};
      currentServiceObj.fields.forEach(function(f) {
        const el = document.getElementById('field_' + f);
        if (el) extracted[f] = el.value.trim();
      });

      pendingPayload = {
        service_type: currentServiceObj.name,
        service_id: currentServiceObj.id,
        applicant_name: document.getElementById('applicantName').value.trim(),
        mobile_no: document.getElementById('mobileNo').value.trim(),
        district: "Sonbhadra",
        document_payload: Object.assign({}, extracted, {
          vle_id: "337237130019",
          center: "विकास जन सेवा केंद्र",
          govt_fee: currentServiceObj.govt_fee,
          vle_fee: currentServiceObj.vle_fee,
          fee_amount: currentServiceObj.total_fee,
          wallet_debit_status: "PENDING_EDISTRICT_PUNCH",
          fee_status: "PAID_UPI"
        })
      };

      document.getElementById('revGovtFee').innerText = "₹" + currentServiceObj.govt_fee;
      document.getElementById('revVleFee').innerText = "₹" + currentServiceObj.vle_fee;
      document.getElementById('revTotalFee').innerText = "₹" + currentServiceObj.total_fee;

      const revContainer = document.getElementById('reviewDossierFields');
      revContainer.innerHTML = '<div><span class="text-slate-400 block">सेवा:</span><strong class="text-indigo-700">' + currentServiceObj.name + '</strong></div>' +
                               '<div><span class="text-slate-400 block">आवेदक:</span><strong class="text-slate-900">' + pendingPayload.applicant_name + '</strong></div>' +
                               '<div><span class="text-slate-400 block">मोबाइल:</span><strong class="text-slate-900 font-mono">' + pendingPayload.mobile_no + '</strong></div>';

      for (const [k, v] of Object.entries(extracted)) {
        revContainer.innerHTML += '<div><span class="text-slate-400 block">' + k + ':</span><strong class="text-slate-800">' + v + '</strong></div>';
      }

      document.getElementById('citizenConsent').checked = false;
      window.updateStepTracker(2);
      document.getElementById('applyForm').classList.add('hidden');
      document.getElementById('reviewStep').classList.remove('hidden');
    };

    window.backToEditForm = function() {
      window.updateStepTracker(1);
      document.getElementById('reviewStep').classList.add('hidden');
      document.getElementById('applyForm').classList.remove('hidden');
    };

    window.backToReviewStep = function() {
      window.updateStepTracker(2);
      document.getElementById('paymentStep').classList.add('hidden');
      document.getElementById('reviewStep').classList.remove('hidden');
    };

    window.confirmAndGoToPayment = function() {
      if (!document.getElementById('citizenConsent').checked) {
        alert("कृपया स्व-घोषणा टिकबॉक्स पर सहमति प्रदान करें!");
        return;
      }
      const totalFee = pendingPayload.document_payload.fee_amount;
      document.getElementById('payFeeDisplay').innerText = "₹" + totalFee;

      const vpa = "theepicvikas@oksbi";
      const upiUrl = "upi://pay?pa=" + vpa + "&pn=Vikas%20Jan%20Seva%20Kendra&am=" + totalFee + "&cu=INR&tn=Govt%20Service%20Fee";
      document.getElementById('upiQrImg').src = "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=" + encodeURIComponent(upiUrl);

      document.getElementById('upiUtrInput').value = '';
      window.validateUtrInput();

      window.updateStepTracker(3);
      document.getElementById('reviewStep').classList.add('hidden');
      document.getElementById('paymentStep').classList.remove('hidden');
    };

    window.validateUtrInput = function() {
      const utr = document.getElementById('upiUtrInput').value.trim();
      const btn = document.getElementById('finalSubmitBtn');
      const msg = document.getElementById('utrValidationMsg');

      if (/^[0-9]{12}$/.test(utr)) {
        btn.disabled = false;
        btn.className = "w-2/3 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-xs shadow-xs cursor-pointer active:scale-95 transition";
        btn.innerText = "सत्यापित करें एवं आवेदन दर्ज करें";
        msg.classList.add('hidden');
      } else {
        btn.disabled = true;
        btn.className = "w-2/3 py-2.5 bg-slate-300 text-slate-500 font-bold rounded-xl text-xs cursor-not-allowed transition";
        btn.innerText = "12-अंकीय UTR दर्ज करें (" + utr.length + "/12)";
        if (utr.length > 0 && utr.length < 12) {
          msg.classList.remove('hidden');
        } else {
          msg.classList.add('hidden');
        }
      }
    };

    window.finalSubmitWithPayment = async function() {
      const utr = document.getElementById('upiUtrInput').value.trim();
      if (!/^[0-9]{12}$/.test(utr)) {
        alert("कृपया सही 12 अंकों का UPI UTR दर्ज करें!");
        return;
      }

      if (/^(\d)\1{11}$/.test(utr) || utr === "123456789012") {
        alert("अवैध UTR नंबर! कृपया अपने UPI ऐप में देखकर वास्तविक 12 अंकों का Reference No. दर्ज करें।");
        return;
      }

      const btn = document.getElementById('finalSubmitBtn');
      btn.disabled = true;
      btn.innerText = "सुरक्षित दर्ज हो रहा है...";

      try {
        let appNo = "DT-" + new Date().toISOString().slice(2,7).replace('-','') + "-" + Math.floor(1000 + Math.random() * 9000);
        pendingPayload.document_payload.upi_utr = utr;

        if (sb) {
          const { data, error } = await sb.from('applications').insert([pendingPayload]).select();
          if (!error && data && data[0]) {
            appNo = data[0].application_no;
          }
        }

        window.closeModal();

        document.getElementById('rcptAppNo').innerText = appNo;
        document.getElementById('rcptDateTime').innerText = new Date().toLocaleString('hi-IN');
        document.getElementById('rcptName').innerText = pendingPayload.applicant_name;
        document.getElementById('rcptMobile').innerText = pendingPayload.mobile_no;
        document.getElementById('rcptService').innerText = pendingPayload.service_type;
        document.getElementById('rcptGovtFee').innerText = "₹" + pendingPayload.document_payload.govt_fee;
        document.getElementById('rcptVleFee').innerText = "₹" + pendingPayload.document_payload.vle_fee;
        document.getElementById('rcptTotalFee').innerText = "₹" + pendingPayload.document_payload.fee_amount;
        document.getElementById('rcptUtrNo').innerText = utr;

        const verifyUrl = "https://doctech-app.pages.dev/?track=" + appNo;
        document.getElementById('rcptVerifyQrImg').src = "https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=" + encodeURIComponent(verifyUrl);

        const rm = document.getElementById('receiptModal');
        rm.classList.remove('hidden');
        rm.classList.add('flex');

        document.getElementById('trackInput').value = appNo;
      } catch (err) {
        alert("त्रुटि: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerText = "सत्यापित करें एवं आवेदन दर्ज करें";
      }
    };

    window.handleTrack = async function() {
      const appNo = document.getElementById('trackInput').value.trim().toUpperCase();
      if (!appNo) return;

      let app = null;
      if (sb) {
        try {
          const { data, error } = await sb.from('applications').select('*').eq('application_no', appNo).maybeSingle();
          if (!error && data) app = data;
        } catch (e) {}
      }

      if (!app) {
        alert("आवेदन संख्या '" + appNo + "' प्राप्त नहीं हुई। कृपया सही संख्या जांचें।");
        return;
      }

      document.getElementById('resAppNo').innerText = app.application_no;
      document.getElementById('resName').innerText = app.applicant_name;
      document.getElementById('resService').innerText = app.service_type;
      document.getElementById('resGovtRef').innerText = (app.document_payload && app.document_payload.govt_edistrict_ref) || 'प्रक्रियाधीन';
      document.getElementById('resDate').innerText = new Date(app.created_at).toLocaleDateString('hi-IN');

      const badge = document.getElementById('resStatusBadge');
      badge.innerText = app.status;
      badge.className = app.status === 'APPROVED' 
        ? "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"
        : "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200";

      const activeCls = "p-1 rounded bg-indigo-600 text-white font-black shadow-xs";
      const inactCls = "p-1 rounded bg-slate-100 text-slate-500 font-bold";

      document.getElementById('step_submit').className = activeCls;
      document.getElementById('step_punch').className = (app.document_payload && app.document_payload.wallet_debit_status === 'DEBITED_ON_EDISTRICT') ? activeCls : inactCls;
      document.getElementById('step_inquiry').className = (app.status === 'IN_PROCESS' || app.status === 'APPROVED') ? activeCls : inactCls;
      document.getElementById('step_approved').className = app.status === 'APPROVED' ? activeCls : inactCls;
      document.getElementById('step_delivered').className = (app.status === 'APPROVED' && app.document_payload && app.document_payload.certificate_url) ? activeCls : inactCls;

      const certBox = document.getElementById('certContainer');
      const certUrl = app.document_payload && app.document_payload.certificate_url;
      if (app.status === 'APPROVED' && certUrl) {
        document.getElementById('certLink').href = certUrl;
        certBox.classList.remove('hidden');
      } else {
        certBox.classList.add('hidden');
      }

      document.getElementById('trackResultBox').classList.remove('hidden');
    };

    window.executeSearchByMobile = async function() {
      const mob = document.getElementById('searchMobileInput').value.trim();
      if (!/^[0-9]{10}$/.test(mob)) {
        alert("कृपया सही 10 अंकों का मोबाइल नंबर दर्ज करें!");
        return;
      }
      const resContainer = document.getElementById('mobileSearchResults');
      resContainer.innerHTML = '<div class="p-3 text-center text-slate-400 text-xs">खोजा जा रहा है...</div>';
      resContainer.classList.remove('hidden');

      if (!sb) {
        resContainer.innerHTML = '<div class="p-3 text-center text-rose-500 font-bold text-xs">डेटाबेस सर्वर कनेक्ट नहीं हुआ।</div>';
        return;
      }

      const { data, error } = await sb.from('applications').select('application_no, applicant_name, service_type, status, created_at').eq('mobile_no', mob).order('created_at', { ascending: false });
      if (error || !data || data.length === 0) {
        resContainer.innerHTML = '<div class="p-3 text-center text-rose-500 font-bold text-xs">इस मोबाइल नंबर से कोई आवेदन नहीं मिला।</div>';
        return;
      }

      resContainer.innerHTML = '';
      data.forEach(function(app) {
        const item = document.createElement('div');
        item.className = "p-2.5 bg-slate-50 hover:bg-indigo-50 rounded-xl cursor-pointer border border-slate-200 transition space-y-1";
        item.onclick = function() {
          window.closeMobileSearchModal();
          document.getElementById('trackInput').value = app.application_no;
          window.handleTrack();
          document.getElementById('trackInput').scrollIntoView({ behavior: 'smooth', block: 'center' });
        };
        item.innerHTML = '<div class="flex items-center justify-between"><span class="font-mono font-bold text-indigo-700 text-xs">' + app.application_no + '</span><span class="px-2 py-0.5 rounded text-[9px] font-bold ' + (app.status === 'APPROVED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800') + '">' + app.status + '</span></div><div class="text-[11px] text-slate-800 font-semibold">' + app.service_type + ' • ' + app.applicant_name + '</div><div class="text-[10px] text-slate-400">' + new Date(app.created_at).toLocaleDateString('hi-IN') + ' (क्लिक करके स्थिति देखें)</div>';
        resContainer.appendChild(item);
      });
    };

    window.playAudioIntro = function() {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance("विकास जन सेवा केंद्र में आपका स्वागत है। उत्तर प्रदेश शासन के सभी प्रमाण पत्र एवं सरकारी योजनाओं के लिए आवेदन करें अथवा सीधे आधिकारिक विभागीय पोर्टल पर जाएं।");
      u.lang = 'hi-IN';
      window.speechSynthesis.speak(u);
    };

    window.educateService = function(name, gFee, vFee) {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(name + "। सरकारी चालान शुल्क ₹" + gFee + " है और केंद्र सेवा शुल्क ₹" + vFee + " है। कुल देय शुल्क ₹" + (parseFloat(gFee) + parseFloat(vFee)).toFixed(2) + " है।");
      u.lang = 'hi-IN';
      window.speechSynthesis.speak(u);
    };

    window.addEventListener('DOMContentLoaded', function() {
      const p = new URLSearchParams(window.location.search).get('track');
      if (p) {
        document.getElementById('trackInput').value = p.trim().toUpperCase();
        setTimeout(window.handleTrack, 400);
      }
    });
  </script>
</Layout>
