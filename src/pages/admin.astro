---
import Layout from '../layouts/Layout.astro';
---
<Layout title="विकास जन सेवा केंद्र | VLE ऑपरेटर कंसोल">
  <div id="authGate" class="fixed inset-0 z-50 bg-slate-950 flex items-center justify-center p-4">
    <div class="bg-white max-w-sm w-full rounded-3xl shadow-2xl border border-slate-200 p-8 text-center space-y-4">
      <img src="/favicon.svg" alt="DocTech Logo" class="w-14 h-14 rounded-2xl mx-auto shadow-md" />
      <div>
        <h2 class="text-base font-bold text-slate-900">विकास जन सेवा केंद्र</h2>
        <p class="text-[11px] text-slate-500 font-mono">VLE ID: 337237130019 | सुरक्षित कंसोल</p>
      </div>
      <div class="space-y-3">
        <input type="password" id="operatorKey" placeholder="मास्टर पिन दर्ज करें" 
               class="w-full px-4 py-3 border border-slate-300 rounded-xl text-center text-sm font-semibold tracking-wider focus:outline-none focus:border-indigo-600">
        <button onclick="window.handleSecureAuth()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm shadow-md transition active:scale-95">
          सत्यापन करें
        </button>
      </div>
    </div>
  </div>

  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img src="/favicon.svg" alt="DocTech Logo" class="w-10 h-10 rounded-xl shadow-xs" />
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-slate-900 text-base leading-none">विकास जन सेवा केंद्र</span>
            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-100">Enterprise Desk</span>
          </div>
          <span class="text-[11px] text-slate-500 font-mono">VLE ID: 337237130019 | रॉबर्ट्सगंज</span>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-indigo-600 border border-slate-200">नागरिक पोर्टल &rarr;</a>
        <button onclick="window.logout()" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-600 hover:bg-rose-50 border border-rose-200">लॉगआउट</button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 w-full flex-1 space-y-6">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-slate-900">नागरिक आवेदन एवं UTR सत्यापन लेज़र</h2>
          <p class="text-[11px] text-slate-500">बैंक SMS से UTR मिलान करने के बाद e-District पोर्टल पर पंच करें</p>
        </div>
        <button onclick="window.fetchApps()" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">रिफ्रेश</button>
      </div>
      <div id="applicationsContainer" class="divide-y divide-slate-100"></div>
    </div>
  </main>

  <script is:inline>
    const SUPABASE_URL = "https://bpfbdmonxbdiwflpxpzt.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJwZmJkbW9ueGJkaXdmbHB4cHp0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2MjgyMzksImV4cCI6MjEwNTIwNDIzOX0.1KglQKHg-nloSaK1myghjVpNpcwAYzWdJ1_bBv0gclU";
    let sb = null;
    if (window.supabase) {
      sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }

    let allApps = [];
    const HASH_TARGET = "d42d38faee2d308dbda3b2c6a01490212f45ea2e88a0b0ea4cfba533cf234c9f"; // DIGISONE2026
    const HASH_BACKUP = "03ac674216f3e15c761ee1a5e255f067953623c8b388b4459e13f978d7c846f4"; // 1234

    async function sha256(message) {
      const msgBuffer = new TextEncoder().encode(message);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    window.handleSecureAuth = async function() {
      const inputPin = document.getElementById('operatorKey').value.trim();
      const hashed = await sha256(inputPin);
      if (hashed === HASH_TARGET || hashed === HASH_BACKUP) {
        sessionStorage.setItem('dt_auth_modern', hashed);
        document.getElementById('authGate').classList.add('hidden');
        window.fetchApps();
      } else {
        alert("अवैध पिन!");
      }
    };

    window.checkAuth = function() {
      const stored = sessionStorage.getItem('dt_auth_modern');
      if (stored === HASH_TARGET || stored === HASH_BACKUP) {
        document.getElementById('authGate').classList.add('hidden');
        window.fetchApps();
      }
    };

    window.logout = function() {
      sessionStorage.removeItem('dt_auth_modern');
      location.reload();
    };

    window.fetchApps = async function() {
      const container = document.getElementById('applicationsContainer');
      container.innerHTML = '<div class="p-8 text-center text-xs text-slate-400">लेज़र लोड हो रहा है...</div>';

      if (!sb) {
        container.innerHTML = '<div class="p-8 text-center text-xs text-rose-500 font-semibold">Supabase कनेक्ट नहीं है।</div>';
        return;
      }

      const { data, error } = await sb.from('applications').select('*').order('created_at', { ascending: false });
      if (error || !data) {
        container.innerHTML = '<div class="p-8 text-center text-xs text-rose-500 font-semibold">डेटा लोड नहीं हुआ।</div>';
        return;
      }

      allApps = data;
      container.innerHTML = '';

      if (allApps.length === 0) {
        container.innerHTML = '<div class="p-8 text-center text-xs text-slate-400">कोई आवेदन रिकॉर्ड नहीं है।</div>';
        return;
      }

      allApps.forEach(function(app) {
        const p = app.document_payload || {};
        const div = document.createElement('div');
        div.className = "p-4 hover:bg-slate-50 transition flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3";
        div.innerHTML = '<div class="space-y-1 min-w-0">' +
          '<div class="flex items-center gap-2"><span class="font-mono font-bold text-sm text-indigo-700">' + app.application_no + '</span><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">' + app.status + '</span><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-900 border border-indigo-200">UTR: <strong class="font-mono">' + (p.upi_utr || 'N/A') + '</strong></span></div>' +
          '<div class="text-xs text-slate-800 font-semibold">' + app.applicant_name + ' | ' + app.service_type + ' | ' + app.mobile_no + '</div>' +
          '<div class="text-[11px] text-slate-500 font-mono">कुल प्राप्त: ₹' + (p.fee_amount || '30.00') + ' (सरकारी: ₹' + (p.govt_fee || '0.00') + ' + VLE: ₹' + (p.vle_fee || '30.00') + ')</div>' +
          '</div>';
        container.appendChild(div);
      });
    };

    window.checkAuth();
  </script>
</Layout>
