---
import Layout from '../../layouts/Layout.astro';
import masterData from '../../data/master_core.json';

export async function getStaticPaths() {
  const services = masterData.services || [];
  const departments = masterData.departments || [];
  return services.map((svc) => {
    const dept = departments.find(d => d.id === svc.dept_id);
    return {
      params: { id: svc.id },
      props: { svc, dept }
    };
  });
}

const { svc, dept } = Astro.props;
const totalFee = (svc.govt_fee + svc.vle_fee).toFixed(2);
const serviceFields = svc.fields || [];
---
<Layout title={`${svc.name} - आधिकारिक आवेदन फ़ॉर्म | विकास जन सेवा केंद्र`}>
  <main class="max-w-3xl mx-auto px-4 py-8 space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-semibold no-print">
      <a href="/" class="hover:text-indigo-600">होम</a>
      <span>/</span>
      <a href={`/department/${dept ? dept.id : 'revenue'}`} class="hover:text-indigo-600">
        {dept ? dept.name.split('(')[0].trim() : 'विभाग'}
      </a>
      <span>/</span>
      <span class="text-slate-900 font-bold truncate">{svc.name}</span>
    </nav>

    <!-- Top Statutory Guarantee Strip -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <span class="px-3 py-1 rounded-full text-xs font-black bg-indigo-50 text-indigo-700 border border-indigo-100">
          {dept ? dept.name : 'उत्तर प्रदेश शासन'}
        </span>
        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
          अनुमानित निस्तारण: {svc.timeline}
        </span>
      </div>

      <div>
        <h1 class="text-xl sm:text-3xl font-black text-slate-900 leading-tight">{svc.name}</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1.5 leading-relaxed font-medium">{svc.desc}</p>
      </div>

      <!-- Transparent Itemized Pricing Card -->
      <div class="bg-indigo-50/70 p-4 rounded-2xl border border-indigo-100 text-xs space-y-2">
        <div class="flex justify-between text-slate-700">
          <span>1. शासकीय कोषागार / e-District वॉलेट चालान:</span>
          <span class="font-mono font-bold text-slate-900">₹{svc.govt_fee.toFixed(2)}</span>
        </div>
        <div class="flex justify-between text-slate-700">
          <span>2. अधिकृत VLE तकनीकी, ड्राफ्टिंग व सेवा शुल्क:</span>
          <span class="font-mono font-bold text-slate-900">₹{svc.vle_fee.toFixed(2)}</span>
        </div>
        <div class="flex justify-between text-indigo-950 font-black border-t border-indigo-200/70 pt-2 text-sm">
          <span>कुल देय वैधानिक दर (Total Payable):</span>
          <span class="font-mono text-indigo-700 text-base">₹{totalFee}</span>
        </div>
      </div>
    </div>

    <!-- MAIN DEDICATED FORM -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
      
      <form id="dedicatedApplyForm" onsubmit="window.handleFormSubmit(event)" class="space-y-6 text-xs">
        <input type="hidden" id="serviceId" value={svc.id} />
        <input type="hidden" id="serviceName" value={svc.name} />
        <input type="hidden" id="govtFee" value={svc.govt_fee.toFixed(2)} />
        <input type="hidden" id="vleFee" value={svc.vle_fee.toFixed(2)} />
        <input type="hidden" id="totalFee" value={totalFee} />

        <!-- STEP 1: APPLICANT IDENTITY -->
        <div class="space-y-3.5">
          <h2 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center gap-2">
            <span>👤</span> <span>1. आवेदक का व्यक्तिगत विवरण (आधार अनुसार)</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">आवेदक का पूरा नाम *</label>
              <input type="text" id="applicantName" required placeholder="आधार अनुसार पूरा नाम" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-semibold text-xs focus:outline-none focus:border-indigo-600">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">मोबाइल नंबर (WhatsApp पावती हेतु) *</label>
              <input type="tel" id="mobileNo" required pattern="[0-9]{10}" placeholder="10 अंकों का मोबाइल नंबर" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono font-bold text-xs focus:outline-none focus:border-indigo-600">
            </div>
          </div>
        </div>

        <!-- STEP 2: DEPARTMENT SPECIFIC POLYMORPHIC FIELDS -->
        <div class="space-y-3.5 pt-2">
          <h2 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center gap-2">
            <span>📋</span> <span>2. विभागीय आवश्यक जानकारी</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="polyFieldsGrid">
            
            {serviceFields.includes('father_name') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">पिता / पति का नाम *</label>
                <input type="text" id="field_father_name" required placeholder="पिता अथवा पति का नाम" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('husband_name') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">पति का नाम *</label>
                <input type="text" id="field_husband_name" required placeholder="पति का नाम" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('deceased_name') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">मृतक का पूरा नाम *</label>
                <input type="text" id="field_deceased_name" required placeholder="मृतक खातेदार/व्यक्ति का नाम" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('deceased_husband_name') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">स्वर्गीय पति का नाम *</label>
                <input type="text" id="field_deceased_husband_name" required placeholder="स्वर्गीय पति का नाम" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('dob') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">जन्मतिथि (Date of Birth) *</label>
                <input type="date" id="field_dob" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-mono font-bold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('death_date') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">मृत्यु की तिथि *</label>
                <input type="date" id="field_death_date" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-mono font-bold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('annual_income') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">घोषित वार्षिक आय (₹) *</label>
                <input type="number" id="field_annual_income" required placeholder="उदा. 48000" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('khasra_gata_no') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">गाटा संख्या / खसरा नंबर *</label>
                <input type="text" id="field_khasra_gata_no" required placeholder="उदा. 142/1 या 205" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-mono font-bold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('village_name') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">राजस्व ग्राम का नाम *</label>
                <input type="text" id="field_village_name" required placeholder="ग्राम का नाम दर्ज करें" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('thana_jurisdiction') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">संबंधित कोतवाली / थाना *</label>
                <input type="text" id="field_thana_jurisdiction" required placeholder="उदा. कोतवाली रॉबर्ट्सगंज" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('caste_category') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">जाति वर्ग (Category) *</label>
                <select id="field_caste_category" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-bold focus:outline-none focus:border-indigo-600">
                  <option value="OBC (अन्य पिछड़ा वर्ग)">OBC (अन्य पिछड़ा वर्ग)</option>
                  <option value="SC (अनुसूचित जाति)">SC (अनुसूचित जाति)</option>
                  <option value="ST (अनुसूचित जनजाति)">ST (अनुसूचित जनजाति)</option>
                  <option value="General (सामान्य)">General (सामान्य)</option>
                </select>
              </div>
            )}

            {serviceFields.includes('sub_caste') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">उप-जाति (Sub-caste) *</label>
                <input type="text" id="field_sub_caste" required placeholder="उप-जाति लिखें" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('vehicle_category') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">वाहन श्रेणी *</label>
                <select id="field_vehicle_category" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-bold focus:outline-none focus:border-indigo-600">
                  <option value="MCWG (दोपहिया)">MCWG (दोपहिया)</option>
                  <option value="LMV (चारपहिया)">LMV (चारपहिया)</option>
                  <option value="BOTH (दोपहिया + चारपहिया)">BOTH (दोपहिया + चारपहिया)</option>
                </select>
              </div>
            )}

            {serviceFields.includes('blood_group') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">रक्त समूह (Blood Group) *</label>
                <select id="field_blood_group" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-bold focus:outline-none focus:border-indigo-600">
                  <option value="O+">O+</option>
                  <option value="O-">O-</option>
                  <option value="A+">A+</option>
                  <option value="A-">A-</option>
                  <option value="B+">B+</option>
                  <option value="B-">B-</option>
                  <option value="AB+">AB+</option>
                  <option value="AB-">AB-</option>
                  <option value="अज्ञात">अज्ञात</option>
                </select>
              </div>
            )}

            {serviceFields.includes('bank_account_no') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">बैंक खाता संख्या *</label>
                <input type="text" id="field_bank_account_no" required placeholder="बैंक खाता संख्या" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono text-xs font-bold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('bank_ifsc') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">बैंक IFSC कोड *</label>
                <input type="text" id="field_bank_ifsc" required placeholder="उदा. SBIN0001234" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono text-xs font-bold focus:outline-none focus:border-indigo-600 uppercase">
              </div>
            )}

            {serviceFields.includes('aadhaar_no') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">आधार संख्या (12 अंक) *</label>
                <input type="text" id="field_aadhaar_no" required pattern="[0-9]{12}" maxlength="12" placeholder="12 अंकों का आधार नंबर" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono text-xs font-bold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            {serviceFields.includes('electricity_load_kw') && (
              <div>
                <label class="block font-bold text-slate-700 mb-1">विद्युत भार (kW) *</label>
                <input type="number" id="field_electricity_load_kw" required placeholder="उदा. 1 या 2 kW" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-bold focus:outline-none focus:border-indigo-600">
              </div>
            )}

            <!-- Universal Tehsil & Address -->
            <div>
              <label class="block font-bold text-slate-700 mb-1">तहसील (सोनभद्र) *</label>
              <select id="tehsil" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-bold focus:outline-none focus:border-indigo-600">
                <option value="Robertsganj">रॉबर्ट्सगंज (Robertsganj)</option>
                <option value="Ghorawal">घोरावल (Ghorawal)</option>
                <option value="Duddhi">दुद्धी (Duddhi)</option>
                <option value="Obra">ओबरा (Obra)</option>
              </select>
            </div>

            <div class="sm:col-span-2">
              <label class="block font-bold text-slate-700 mb-1">पूरा स्थायी पता (ग्राम / वार्ड / पोस्ट) *</label>
              <textarea id="address" required rows="2" placeholder="मकान नं., ग्राम/मोहल्ला, पोस्ट, पिन कोड" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs font-medium focus:outline-none focus:border-indigo-600"></textarea>
            </div>
          </div>
        </div>

        <!-- STEP 3: DOCUMENT UPLOAD WITH CANVAS COMPRESSION -->
        <div class="space-y-3.5 pt-2">
          <h2 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center gap-2">
            <span>📎</span> <span>3. अनिवार्य दस्तावेज़ संलग्नक (अधिकतम 10MB)</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-2xl border border-slate-200 bg-slate-50 space-y-1.5">
              <label class="block font-bold text-slate-700 text-xs">1. आवेदक की फ़ोटो *</label>
              <input type="file" id="applicantPhoto" accept="image/*" required class="w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-600 file:text-white cursor-pointer">
              <span class="text-[10px] text-slate-400 block">कैमरे से खींची गई फ़ोटो स्वतः कंप्रेस होगी</span>
            </div>

            <div class="p-3.5 rounded-2xl border border-slate-200 bg-slate-50 space-y-1.5">
              <label class="block font-bold text-slate-700 text-xs">2. पहचान प्रमाण (आधार कार्ड) *</label>
              <input type="file" id="idProof" accept="image/*,.pdf" required class="w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-600 file:text-white cursor-pointer">
              <span class="text-[10px] text-slate-400 block">साफ फोटो अथवा PDF चुनें</span>
            </div>
          </div>
        </div>

        <!-- STEP 4: STATUTORY FEE PAYMENT & UTR ANTI-FRAUD LOCK -->
        <div class="space-y-3.5 pt-2">
          <h2 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center gap-2">
            <span>💳</span> <span>4. शासकीय एवं सेवा शुल्क भुगतान (₹{totalFee})</span>
          </h2>

          <div class="p-4 rounded-2xl bg-indigo-50/80 border border-indigo-100 flex flex-col items-center text-center space-y-3">
            <img src={`https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=upi://pay?pa=theepicvikas@oksbi%26pn=Vikas%20Jan%20Seva%20Kendra%26am=${totalFee}%26cu=INR`} 
                 alt="UPI QR" class="w-40 h-40 rounded-2xl border border-white shadow-xs p-1 bg-white" />
            
            <div class="space-y-1">
              <span class="text-xs text-slate-800 font-bold block">PhonePe, Google Pay, Paytm अथवा किसी भी UPI ऐप से स्कैन करें</span>
              <span class="font-mono text-indigo-900 font-extrabold text-xs block">VPA: theepicvikas@oksbi</span>
            </div>
          </div>

          <div class="bg-amber-50 p-4 rounded-2xl border border-amber-200 space-y-1.5">
            <label class="block font-bold text-amber-950 text-xs">
              भुगतान के बाद 12 अंकों का UPI UTR / Transaction Reference No. यहाँ दर्ज करें *
            </label>
            <input type="text" id="upiUtr" required maxlength="12" pattern="[0-9]{12}" 
                   placeholder="12 अंकों का UTR नंबर (उदा. 426189123456)" 
                   class="w-full px-3.5 py-2.5 rounded-xl border border-amber-300 bg-white font-mono font-bold text-xs tracking-wider focus:outline-none focus:ring-2 focus:ring-amber-500">
            <span class="text-[10px] text-amber-800 block">यह नंबर आपके बैंक खाते से भुगतान सत्यापन हेतु अनिवार्य है।</span>
          </div>
        </div>

        <!-- Self Declaration Checkbox -->
        <label class="flex items-start gap-2.5 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 cursor-pointer">
          <input type="checkbox" id="consent" required class="mt-0.5 w-4 h-4 rounded text-indigo-600 border-slate-300 focus:ring-indigo-500">
          <span class="text-[11px] text-slate-700 leading-normal font-semibold">
            मैं प्रमाणित करता/करती हूँ कि मेरे द्वारा दिए गए सभी विवरण पूर्णतया सत्य हैं एवं मैं निर्धारित वैधानिक शुल्क भुगतान हेतु सहमत हूँ।
          </span>
        </label>

        <button type="submit" id="submitBtn" class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black rounded-2xl shadow-md transition text-xs active:scale-95 flex items-center justify-center gap-2">
          <span>सत्यापित करें एवं आवेदन जमा करें</span>
          <span>&rarr;</span>
        </button>
      </form>
    </div>

    <!-- ON-PAGE OFFICIAL DIGITAL ACKNOWLEDGEMENT SLIP MODAL (OPENS ON SUBMIT) -->
    <div id="instantReceiptModal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs hidden items-center justify-center p-3 overflow-y-auto">
      <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl border border-slate-200 my-4 overflow-hidden flex flex-col">
        <div class="px-5 py-3.5 border-b border-slate-200 bg-slate-100 flex items-center justify-between no-print">
          <span class="text-xs font-bold text-emerald-800 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            आवेदन सफलतापूर्वक दर्ज हुआ!
          </span>
          <div class="flex items-center gap-2">
            <button onclick="window.print()" class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition">
              🖨️ रसीद प्रिंट करें
            </button>
            <button onclick="window.closeReceiptAndRedirect()" class="w-7 h-7 rounded-full bg-slate-200 text-slate-600 hover:bg-slate-300 flex items-center justify-center text-sm font-bold">&times;</button>
          </div>
        </div>

        <div id="printableReceiptArea" class="p-8 text-xs text-slate-900 space-y-4 bg-white">
          <div class="text-center border-b-2 border-slate-900 pb-3 space-y-1">
