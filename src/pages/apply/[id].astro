  <!-- CLIENT-SIDE APPLICATION ENGINE -->
  <script is:inline>
    const SUPABASE_URL = "https://bpfbdmonxbdiwflpxpzt.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJwZmJkbW9ueGJkaXdmbHB4cHp0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2MjgyMzksImV4cCI6MjEwNTIwNDIzOX0.1KglQKHg-nloSaK1myghjVpNpcwAYzWdJ1_bBv0gclU";
    let sb = null;
    if (window.supabase) {
      sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }

    let generatedAppNo = "";

    // Client-side Canvas Image Compressor (15MB -> ~200KB in <1s)
    function compressImageFile(file, maxDimension = 1200, quality = 0.8) {
      return new Promise((resolve) => {
        if (!file || !file.type.startsWith('image/')) return resolve(file);
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (e) => {
          const img = new Image();
          img.src = e.target.result;
          img.onload = () => {
            let width = img.width;
            let height = img.height;
            if (width > height) {
              if (width > maxDimension) {
                height = Math.round((height * maxDimension) / width);
                width = maxDimension;
              }
            } else {
              if (height > maxDimension) {
                width = Math.round((width * maxDimension) / height);
                height = maxDimension;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            canvas.toBlob((blob) => {
              if (blob) {
                resolve(new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' }));
              } else {
                resolve(file);
              }
            }, 'image/jpeg', quality);
          };
          img.onerror = () => resolve(file);
        };
        reader.onerror = () => resolve(file);
      });
    }

    async function uploadDocument(file, prefix) {
      if (!file || !sb) return "";
      try {
        const compressed = await compressImageFile(file);
        const ext = compressed.name.split('.').pop();
        const path = `applications/${prefix}_${Date.now()}_${Math.random().toString(36).substring(7)}.${ext}`;
        const { error } = await sb.storage.from('applicant-docs').upload(path, compressed);
        if (error) throw error;
        const { data } = sb.storage.from('applicant-docs').getPublicUrl(path);
        return data ? data.publicUrl : "";
      } catch (err) {
        console.warn("Upload fallback:", err);
        return "";
      }
    }

    window.handleFormSubmit = async function(e) {
      e.preventDefault();
      const utr = document.getElementById('upiUtr').value.trim();

      if (!/^[0-9]{12}$/.test(utr)) {
        alert("कृपया सही 12 अंकों का UPI UTR नंबर दर्ज करें!");
        return;
      }
      if (/^(\d)\1{11}$/.test(utr) || utr === "123456789012") {
        alert("अवैध UTR नंबर! कृपया अपने UPI ऐप में देखकर वास्तविक 12 अंकों का Reference No. दर्ज करें।");
        return;
      }

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerText = "सुरक्षा एवं UTR सत्यापन जांच...";

      try {
        // Duplicate UTR check in Supabase
        if (sb) {
          const { data: dup } = await sb.from('applications').select('application_no').eq('document_payload->>upi_utr', utr).maybeSingle();
          if (dup) {
            alert(`यह UTR नंबर (${utr}) पहले से आवेदन संख्या ${dup.application_no} में दर्ज है! कृपया अपना वास्तविक लेन-देन UTR दर्ज करें।`);
            btn.disabled = false;
            btn.innerText = "सत्यापित करें एवं आवेदन जमा करें →";
            return;
          }
        }

        btn.innerText = "दस्तावेज़ सुरक्षित अपलोड हो रहे हैं...";

        const photoFile = document.getElementById('applicantPhoto').files[0];
        const idFile = document.getElementById('idProof').files[0];

        const photoUrl = await uploadDocument(photoFile, 'photo');
        const idUrl = await uploadDocument(idFile, 'id_proof');

        btn.innerText = "आवेदन अधिकृत रूप से दर्ज हो रहा है...";

        // Collect all dynamic fields
        const polyPayload = {};
        const polyInputs = document.querySelectorAll('#polyFieldsGrid input, #polyFieldsGrid select, #polyFieldsGrid textarea');
        polyInputs.forEach(el => {
          if (el.id) {
            const key = el.id.replace('field_', '');
            polyPayload[key] = el.value.trim();
          }
        });

        const appPayload = {
          service_type: document.getElementById('serviceName').value,
          service_id: document.getElementById('serviceId').value,
          applicant_name: document.getElementById('applicantName').value.trim(),
          mobile_no: document.getElementById('mobileNo').value.trim(),
          district: "Sonbhadra",
          document_payload: Object.assign({}, polyPayload, {
            tehsil: document.getElementById('tehsil').value,
            address: document.getElementById('address').value.trim(),
            upi_utr: utr,
            govt_fee: document.getElementById('govtFee').value,
            vle_fee: document.getElementById('vleFee').value,
            fee_amount: document.getElementById('totalFee').value,
            fee_status: "PAID_UPI",
            wallet_debit_status: "PENDING_EDISTRICT_PUNCH",
            applicant_photo_doc: photoUrl,
            id_proof_doc: idUrl,
            vle_id: "337237130019",
            center: "विकास जन सेवा केंद्र, रॉबर्ट्सगंज"
          })
        };

        generatedAppNo = "DT-" + new Date().toISOString().slice(2,7).replace('-','') + "-" + Math.floor(1000 + Math.random() * 9000);
        if (sb) {
          const { data, error } = await sb.from('applications').insert([appPayload]).select();
          if (!error && data && data[0]) {
            generatedAppNo = data[0].application_no;
          }
        }

        // Fill Instant Printable Receipt
        document.getElementById('rcptAppNo').innerText = generatedAppNo;
        document.getElementById('rcptDate').innerText = new Date().toLocaleString('hi-IN');
        document.getElementById('rcptName').innerText = appPayload.applicant_name;
        document.getElementById('rcptMobile').innerText = appPayload.mobile_no;
        document.getElementById('rcptService').innerText = appPayload.service_type;
        document.getElementById('rcptGovtFee').innerText = `₹${appPayload.document_payload.govt_fee}`;
        document.getElementById('rcptTotalFee').innerText = `₹${appPayload.document_payload.fee_amount}`;
        document.getElementById('rcptUtr').innerText = utr;

        const verifyUrl = `https://doctech-app.pages.dev/track?app=${generatedAppNo}`;
        document.getElementById('rcptVerifyQr').src = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(verifyUrl)}`;

        // Open Receipt Modal
        const modal = document.getElementById('instantReceiptModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');

        // Optional WhatsApp confirmation
        const waMsg = `नमस्ते ${appPayload.applicant_name} जी, विकास जन सेवा केंद्र पर आपका ${appPayload.service_type} आवेदन दर्ज हुआ।\n\nआवेदन सं: ${generatedAppNo}\nUTR: ${utr}\nट्रैकिंग: ${verifyUrl}`;
        window.open(`https://wa.me/91${appPayload.mobile_no}?text=${encodeURIComponent(waMsg)}`, '_blank');
      } catch(err) {
        alert("त्रुटि: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerText = "सत्यापित करें एवं आवेदन जमा करें →";
      }
    };

    window.closeReceiptAndRedirect = function() {
      window.location.href = `/track?app=${generatedAppNo}`;
    };
  </script>
