---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="hi" class="h-full bg-slate-50 overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="X-Frame-Options" content="DENY" />
  <meta name="theme-color" content="#1e1b4b" />
  <meta name="author" content="विकास जन सेवा केंद्र" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <title>{title}</title>
</head>
<body class="min-h-full flex flex-col text-slate-800 bg-[#F8FAFC] antialiased overflow-x-hidden">
  
  <aside aria-label="Official Center Notice" class="bg-indigo-950 text-indigo-200 text-[11px] py-1.5 px-3 border-b border-indigo-900/70 no-print">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-1.5 truncate">
        <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
        <span class="font-medium truncate">अधिकृत जन सेवा केंद्र (CSC e-Gov & e-District UP)</span>
      </div>
      <div class="flex items-center gap-2 font-mono text-[10px] shrink-0">
        <span class="bg-indigo-900/90 text-indigo-300 px-2 py-0.5 rounded border border-indigo-700/50">VLE: 337237130019</span>
        <span class="bg-indigo-900/90 text-indigo-300 px-2 py-0.5 rounded border border-indigo-700/50 hidden sm:inline">MSME: UDYAM-UP-66</span>
      </div>
    </div>
  </aside>

  <slot />

  <footer class="mt-auto border-t border-slate-200 bg-white pt-8 pb-10 text-xs text-slate-600 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 border-b border-slate-100 pb-6">
        <div>
          <div class="flex items-center gap-2">
            <img src="/favicon.svg" alt="DocTech Logo" class="w-8 h-8 rounded-xl shadow-xs" />
            <span class="font-black text-slate-900 text-sm">विकास जन सेवा केंद्र</span>
          </div>
          <p class="text-[11px] text-slate-500 mt-2 leading-relaxed">
            सोनभद्र एवं रॉबर्ट्सगंज क्षेत्र के नागरिकों हेतु अधिकृत डिजिटल सेवा केंद्र।
          </p>
        </div>

        <div>
          <span class="font-bold text-slate-900 text-xs block mb-2">विधिक एवं वैधानिक अनुपालन</span>
          <ul class="space-y-1 text-[11px] text-slate-500">
            <li>• CSC e-Governance Services India Ltd. अधिकृत</li>
            <li>• डिजिटल पर्सनल डेटा प्रोटेक्शन (DPDP Act 2023) अनुपालित</li>
            <li>• उत्तर प्रदेश ई-डिस्ट्रिक्ट शासनादेश दरें लागू</li>
          </ul>
        </div>

        <div>
          <span class="font-bold text-slate-900 text-xs block mb-2">त्वरित लिंक्स व संपर्क</span>
          <div class="space-y-1.5 text-[11px]">
            <div><a href="/dashboard" class="font-bold text-indigo-600 hover:underline">👤 नागरिक यूज़र डैशबोर्ड &rarr;</a></div>
            <div><a href="/admin" class="font-bold text-slate-600 hover:text-indigo-600 underline">🔐 VLE ऑपरेटर कंसोल &rarr;</a></div>
            <p class="text-[10px] text-slate-400 mt-2">संचालक: विकास मिश्रा | रॉबर्ट्सगंज, सोनभद्र</p>
          </div>
        </div>
      </div>

      <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200 text-[10px] text-slate-500 leading-relaxed">
        <strong>वैधानिक घोषणा:</strong> विकास जन सेवा केंद्र (DocTech) सीएससी ई-गवर्नेंस एवं ई-डिस्ट्रिक्ट उत्तर प्रदेश के अंतर्गत अधिकृत सुविधा केंद्र है। यह पोर्टल उत्तर प्रदेश सरकार अथवा भारत सरकार का आधिकारिक पोर्टल नहीं है।
      </div>

      <div class="text-center text-[11px] text-slate-400">
        &copy; 2026 विकास जन सेवा केंद्र. सर्वाधिकार सुरक्षित।
      </div>
    </div>
  </footer>
</body>
</html>
